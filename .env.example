# Copy to .env and adjust. docker-compose reads this from the repo root.
# The Go server reads DATABASE_URL from its own .env (see server/.env.example).

# Postgres service config (used by compose.yaml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rsudtangsel
POSTGRES_USER=rsudtangsel
POSTGRES_PASSWORD=rsudtangsel
POSTGRES_SSLMODE=disable

# Connection string for the Go server (derived from the values above)
DATABASE_URL=postgres://rsudtangsel:rsudtangsel@localhost:5432/rsudtangsel?sslmode=disable

# OCR microservice (used by compose.yaml - host port untuk service ocr)
OCR_PORT=8000

# ============================================================
# docker-compose (service db, server, web, ocr)
# ============================================================

# Backend URL untuk proxy server-side (app/api/proxy). Server-only —
# browser tidak pernah melihat URL ini. Di dalam docker network, compose web
# service menggantinya dengan http://server:8080 (lihat docker-compose.yaml).
BACKEND_API_URL=http://localhost:8080

# Host port yang dipetakan ke service server (container selalu 8080)
SERVER_PORT=8080

# Auth - ganti JWT_SECRET dengan secret 256-bit yang kuat di produksi!
JWT_SECRET=please-change-me-in-production
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800
BCRYPT_COST=10
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=100

# Admin seed (di-seed otomatis oleh server saat pertama start)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@rsutangsel.go.id
ADMIN_PASSWORD=admin123
