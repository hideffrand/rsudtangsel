# Copy to .env and adjust. docker-compose reads this from the repo root.
# The Go server reads DATABASE_URL from its own .env (see server/.env.example).

# Postgres service config (used by compose.yaml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rsudtangsel
POSTGRES_USER=rsudtangsel
POSTGRES_PASSWORD=rsudtangsel
POSTGRES_SSLMODE=disable

# Connection string for the Go server (derived from the values above)
DATABASE_URL=postgres://rsudtangsel:rsudtangsel@localhost:5432/rsudtangsel?sslmode=disable
