{
  "manifest_version": 3,
  "name": "RSU Tangsel Web-Copilot",
  "version": "0.1.0",
  "description": "Ambil foto atau unggah dokumen lalu otomatis isi form web (registrasi pasien & inventory).",
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Buka Copilot"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel/index.html",
    "default_title": "Webform Copilot",
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webform-copilot@rsutangsel.go.id",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
