{
  "manifest_version": 3,
  "name": "RSU Tangsel Web-Copilot",
  "version": "0.1.0",
  "description": "Ambil foto atau unggah dokumen lalu otomatis isi form web (registrasi pasien & inventory).",
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Buka Copilot"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
